# Контент-аватар эксперта. Скопируйте в .env и заполните секреты.
# Названия BIBLIA_* пока оставлены как в заготовке (переименование — отдельно).

# --- обязательно ---
BIBLIA_BOT_TOKEN=
BIBLIA_DB_NAME=
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
SUPER_ADMIN_ID=

# доступ только bot_admins + SUPER_ADMIN_ID
BOT_ACCESS_ADMIN_ONLY=1

# --- продукт ---
COURSE_ENABLED=1
ACTIVE_PRODUCT=mbt
PRODUCTS_FILE=config/products.json
EXPERT_NAME=

# --- Яндекс.Диск ---
YANDEX_DISK_ENABLED=1
YANDEX_DISK_LOGIN=
YANDEX_DISK_PASSWORD=
COURSE_DISK_ROOT=/Аватар
COURSE_DISK_POLL_SEC=900

# --- видео ---
VIDEO_HOST_PRIORITY=youtube,vimeo,kinescope,disk
COURSE_TRANSCRIBE_MODE=auto
COURSE_SUBS_MIN_CHARS_PER_MIN=300
YTDLP_COOKIES_FILE=
COURSE_PLAYLIST_MAX=100
COURSE_MEDIA_MAX_GB=4
COURSE_TMP_DIR=data/tmp
KINESCOPE_API_TOKEN=
VIMEO_ACCESS_TOKEN=

# --- LLM ---
COURSE_VISION_MODEL=gpt-4o-mini
COURSE_VISION_MAX_PAGES=80
COURSE_MINING_MODEL=gpt-4o-mini
COURSE_PLANNER_MODEL=gpt-4o-mini
CONTENT_WRITER_MODEL=deepseek-v4-flash
STYLE_MODEL=gpt-4o
COURSE_LLM_CONCURRENCY=3
COURSE_CARDS_PER_HOUR=30
COURSE_CARD_DUP_SIM=0.88
COURSE_PASSPORT_DEBOUNCE_SEC=600
COURSE_INFO_MAX_CHARS=8000
COURSE_USE_LEGACY_CHUNKS=1

# --- план недели ---
CONTENT_PLAN_WEEKDAY=0
CONTENT_PLAN_HOUR=9
CONTENT_PLAN_TZ=Europe/Moscow
CONTENT_PLAN_MIX=tg_post:3,reels:2,carousel:1,stories:1
CARD_REUSE_DAYS=60

# цены моделей (JSON) для /costs, необязательно
# COST_TABLE={"gpt-4o-mini":{"in":0.15,"out":0.6},"whisper-1":{"minute":0.006}}

# --- RAG / Chroma ---
RAG_ENABLED=1
CHROMA_PERSIST_DIR=chroma_data
RAG_CARDS_COLLECTION=content_cards
RAG_ADMIN_CHAT_ID=
RAG_ADMIN_TOPIC_ID=

LOG_LEVEL=INFO
